# =============================================================================
#  REALTIX — STAGING (.env)
#  Copiază pe server ca `.env`, completează valorile marcate <...> și rulează
#  `php artisan key:generate`. NU comite acest fișier completat cu secrete.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=REALTIX
APP_ENV=staging
APP_KEY=                                  # php artisan key:generate
APP_DEBUG=false
APP_URL=https://staging.realtix.eu

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ── Database (staging PostgreSQL) ────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<staging_db>
DB_USERNAME=<staging_user>
DB_PASSWORD=<staging_password>

# ── Session / Cache / Queue ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true                # site pe https
SESSION_DOMAIN=staging.realtix.eu         # doar staging, izolat de producție (nu .realtix.eu)
SESSION_COOKIE=realtix_staging_session    # nume distinct → nu se ciocnește cu cookie-ul de producție
CACHE_STORE=database
QUEUE_CONNECTION=database                 # necesită `php artisan queue:work` (supervisor)
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── Mail (staging: log, ca să nu trimită real) ───────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@staging.realtix.eu"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
#  ASISTENT AI
# =============================================================================
# Furnizorul activ: 'groq' (gratuit pt. testare) sau 'anthropic'.
ASSISTANT_LLM_PROVIDER=groq

# Cheia se citește după provider:
#   provider=groq      → GROQ_API_KEY
#   provider=anthropic → ANTHROPIC_API_KEY
GROQ_API_KEY=<gsk_...>
ANTHROPIC_API_KEY=<sk-ant-...>

# Cotă gratuită: obiecte UNICE gratuite per owner înainte de paywall.
ASSISTANT_FREE_RESULTS=50

# (opționale — au default-uri bune în config/assistant.php)
# ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
# ASSISTANT_MODEL_INTENT=claude-haiku-4-5
# ASSISTANT_MODEL_ANSWER=claude-sonnet-5
# ASSISTANT_ANON_MSG_LIMIT=20

# =============================================================================
#  FRONTEND (Vite) — BAKED LA BUILD TIME
# =============================================================================
# TREBUIE să fie prezent în `.env` ÎNAINTE de `npm run build`, altfel appul
# rămâne pe transportul mock și NU lovește backend-ul real.
VITE_APP_NAME="${APP_NAME}"
VITE_ASSISTANT_MOCK=false

# =============================================================================
#  Google OAuth — PLACEHOLDER (se completează când adăugăm login-ul)
#  /assistant NU depinde de asta; auth-ul e necesar doar la contact/paywall.
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login-ul clientului asistentului (OAuth "Sign in with Google" pe /assistant).
# DISTINCT de integrarea Google Calendar a CRM-ului (GOOGLE_REDIRECT_URI din
# config/services.php → /google/calendar/callback), care e alt flow, alt scop.
GOOGLE_REDIRECT_URI="${APP_URL}/assistant/auth/google/callback"

# ── 999.md scraper (dacă staging-ul îl folosește) ────────────────────────────
PYTHON_BIN=python3
PORTAL_999MD_API_KEY=
PORTAL_999MD_BASE_URL=https://partners-api.999.md

# ── AI valuation (feature CRM existent, separat de asistent) ──────────────────
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Stripe (paywall — placeholder pe staging până activăm billing-ul) ────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
