APP_NAME=REALTIX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://realtix.md
APP_TIMEZONE=Europe/Chisinau
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_MD

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=realtix
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Email - Resend (înlocuiește Brevo)
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS=noreply@realtix.md
MAIL_FROM_NAME="REALTIX"

# AI
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 999.md Scraper
PYTHON_BIN=/home/forge/realtix.md/python_scraper/venv/bin/python
SCRAPER_999_DAILY_CAP=200
PORTAL_999MD_API_KEY=
PORTAL_999MD_BASE_URL=https://partners-api.999.md

# Stripe (LIVE keys, nu test!)
# pk_live_xxx (Publishable Key — safe pentru frontend)
STRIPE_KEY=
# sk_live_xxx (Secret Key — nu comita niciodata; pune valoarea reala doar in .env de pe server)
STRIPE_SECRET=
# whsec_xxx (Signing secret pentru webhook endpoint)
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=ro_MD
# price_xxx — NU prod_xxx. Copie Price IDs din Stripe Dashboard → Products → Pricing.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_EXTRA_SEAT=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://realtix.md/google/calendar/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS S3 / Cloudflare R2 (pentru backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=realtix-backup
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
